# ─────────────────────────────────────────────────────────────────────────────
# 서버 전용 env. 값은 이 파일에 쓰지 말고 .env.local 또는 배포 환경변수에만 넣는다.
#
# ⚠️ `NEXT_PUBLIC_` 접두사 금지 (COU-2079 결정 2(a)). NEXT_PUBLIC_* 값은 빌드 시
#    클라이언트 번들에 그대로 인라인되므로 토큰이 사실상 공개값이 된다.
#    발급·보관·로테이션 절차는 docs/api-token-procedure.md 참고.
# ─────────────────────────────────────────────────────────────────────────────

# talent-api 업스트림 오리진. 서버 라우트 프록시가 이 값으로 호스트를 고정한다.
# 형식: https://<host> — 경로 prefix 가 있으면 포함 (예: https://<host>/v1)
TALENT_API_BASE_URL=

# talent-api bearer 토큰. 백엔드 API_AUTH_TOKENS(COU-2064) 에 등록된 값 중 하나.
# 서버 라우트 핸들러에서만 읽히며 클라이언트 번들에는 포함되지 않는다.
TALENT_API_TOKEN=
