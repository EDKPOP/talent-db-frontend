# talent-api base URL (예: https://talent-api.keens.academy)
NEXT_PUBLIC_API_URL=

# talent-api bearer 토큰. 백엔드의 API_AUTH_TOKENS 에 등록된 값 중 하나여야 한다.
#
# ⚠️ 이 값은 비밀이 아니다. 현재 프런트는 전부 클라이언트 컴포넌트라 브라우저가
# talent-api 를 직접 호출하며, NEXT_PUBLIC_* 는 빌드 시 클라이언트 번들에 그대로
# 인라인된다. 최종 구조(프록시 라우트 / 서버 세션)가 결정되기 전까지의 임시 조치다.
# 실제 값은 이 파일이 아니라 .env.local 또는 배포 환경변수에만 넣을 것.
NEXT_PUBLIC_API_TOKEN=
